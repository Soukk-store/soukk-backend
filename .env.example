# =============================================================================
# Soukk backend configuration
#
# Read by the app (pydantic-settings) and by docker compose (variable
# substitution + env_file). Every key here is required: Settings has no defaults.
#
# DB_* and REDIS_* hosts and ports are for running the app on your machine
# (uv run ...); DB_PORT and REDIS_PORT are also the host ports compose publishes
# Postgres and Redis on (bound to 127.0.0.1). The DOCKER_* keys at the bottom are
# how the backend container reaches them inside the compose network instead.
#
# This is a template: copy it to .env and fill in the secrets. Never commit .env.
# =============================================================================


# --- App ---------------------------------------------------------------------
# development enables auto-reload (only when WEB_WORKERS=1).
ENV=development
# Port uvicorn listens on; compose publishes the same port on the host.
PORT=8000
# Uvicorn worker processes.
WEB_WORKERS=1
# Public base URL of this API.
SERVER_URL=http://localhost:8000
# Base URL of the frontend: email links point to /verified and /reset-password
# on it, and it's the only website browsers let call this API (CORS).
FRONTEND_URL=http://localhost:3000


# --- Postgres ----------------------------------------------------------------
# localhost when running the app on the host (compose uses DOCKER_DB_HOST).
DB_HOST=localhost
# Host port Postgres is published on.
DB_PORT=5432
# Also used by compose to create the database user and database on first start.
DB_USER=soukk_user
DB_PASSWORD=change-me
DB_NAME=soukk_db


# --- Redis -------------------------------------------------------------------
# localhost when running the app on the host (compose uses DOCKER_REDIS_HOST).
REDIS_HOST=localhost
# Host port Redis is published on.
REDIS_PORT=6379
# Redis requires this password (compose starts Redis with it; Railway gives one).
REDIS_PASSWORD=change-me
# Redis database number (0-15) holding the rate-limit counters. Kept apart from
# the other Redis users (e.g. the Celery queue on 0) so they never mix.
REDIS_RATE_LIMIT_DB=1
# Redis database number holding the Celery queue: the backend pushes email jobs
# here and the celery worker service picks them up.
REDIS_CELERY_DB=0
# Worker processes in the celery service (each sends one email at a time).
# Celery's default is one per CPU core, far more than email needs.
CELERY_WORKER_CONCURRENCY=2


# --- Maintenance jobs (celery-beat + celery-maintenance) ---------------------
# When the expired refresh token cleanup runs: cron format
# "minute hour day-of-month month day-of-week", in UTC. Default: every day 03:00.
TOKEN_CLEANUP_SCHEDULE="0 3 * * *"
# Tokens deleted per transaction; keeps each delete short even with a big backlog.
TOKEN_CLEANUP_BATCH_SIZE=5000


# --- Tokens ------------------------------------------------------------------
# Signs every JWT. Long random string; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# Lifetime of the access token sent as "Authorization: Bearer".
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Lifetime of a refresh token (one login session per device).
REFRESH_TOKEN_EXPIRE_DAYS=30
# A refresh token reused within this many seconds of being rotated is refused
# but NOT treated as theft: two tabs refreshing at once, or an app retrying after
# losing the response. Reuse after that window logs the whole session out.
REFRESH_REUSE_GRACE_SECONDS=10
# Lifetime of the link in the verification email.
EMAIL_VERIFY_EXPIRE_MINUTES=1440
# Lifetime of the link in the password reset email.
PASSWORD_RESET_EXPIRE_MINUTES=30
# Minimum gap between two emails of the same kind to the same address.
EMAIL_COOLDOWN_SECONDS=60


# --- Mail (SMTP) -------------------------------------------------------------
# Currently the Mailtrap sandbox: emails are caught there, not delivered.
# Leave MAIL_USERNAME empty for an SMTP server without login (e.g. mailpit).
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@soukk.com
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
# Upgrade the connection with STARTTLS (usually port 587).
MAIL_STARTTLS=false
# Connect over TLS from the start (usually port 465).
MAIL_SSL_TLS=false
# Logo shown in email headers; must be a public https URL (placeholder for now).
EMAIL_LOGO_URL=https://placehold.co/60x60/E0A03A/0E5A55/png?text=S


# --- Rate limits (per client IP, counted in Redis) ---------------------------
# Format: "<count>/<second|minute|hour|day>", several joined with ";".
RATE_LIMIT_EMAIL_EXISTS=20/minute;200/hour
RATE_LIMIT_REGISTER=10/hour
RATE_LIMIT_RESEND=5/hour
RATE_LIMIT_LOGIN=5/minute;30/hour
RATE_LIMIT_FORGOT_PASSWORD=5/hour
RATE_LIMIT_RESET_PASSWORD=10/hour
RATE_LIMIT_CHANGE_PASSWORD=5/hour
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_LOGOUT=30/minute

# --- Docker compose network (used by docker-compose.yaml only) ---------------
# Inside compose the backend reaches the services by service name on the port
# the service listens on in its container. Compose passes these to the backend
# as DB_HOST/DB_PORT/REDIS_HOST/REDIS_PORT and starts the services on these ports.
# The hosts must match the service names in docker-compose.yaml.
DOCKER_DB_HOST=postgres-db
DOCKER_DB_PORT=5432
DOCKER_REDIS_HOST=redis
DOCKER_REDIS_PORT=6379
